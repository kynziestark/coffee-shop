      line-height: 1.2;
      margin-top: 0;
    }

    h2, h3 {
      color: var(--green);
      font-family: Georgia, "Times New Roman", serif;
      line-height: 1.3;
    }

    section { margin: 36px 0; }

    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
      gap: 18px;
    }

    .card {
      background: var(--white);
      border: 1px solid #e5dfd3;
      border-radius: 10px;
      padding: 22px;
    }

    .card h3 { margin-top: 0; }

    .highlight {
      background: var(--sage);
      border-radius: 10px;
      padding: 22px;
